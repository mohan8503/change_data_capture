import json
import apache_beam as beam
from apache_beam.options.pipeline_options import PipelineOptions,SetupOptions
from apache_beam.transforms import window, trigger
from apache_beam.pvalue import TaggedOutput
import datetime
from google.cloud import bigquery 

def json_data(data):
    data = json.loads(data.decode('utf-8'))
    return data

def router_fn(data):
    if data["payload"]['op'] == 'r' :
       return  TaggedOutput(data,'create')
    elif data["payload"]['op'] == 'c' :
       return  TaggedOutput(data,'append') 
    elif data["payload"]['op'] == 'u' :
       return  TaggedOutput(data,'update') 
    elif data["payload"]['op'] == 'd' :
       return  TaggedOutput(data,'delete') 
    
def set_schema(data):
   config = {'int32':'INTEGER','string':'STRING',"io.debezium.time.Timestamp":"DATETIME","double":"FLOAT"}
   schema_bigquery = [] 
   for fields in data['schema']['fields'][0]['fields']:
         if fields.get('name',None):
            x = {"name": f"{fields['field']}","type":f"{config.get(fields['name'])}"}
         else:
            x = {"name": f"{fields['field']}","type":f"{config.get(fields['type'])}"} 
         schema_bigquery.append(x)
   schema_bigquery.append({"name": "op","type":"STRING"})
   schema_bigquery.append({"name": "table_name","type":"STRING"})
   schema_bigquery.append({"name": "source_ts_ms","type":"DATETIME"})
   schema_bigquery.append({"name": "debezium_ts_ms","type":"DATETIME"})
   return schema_bigquery

def format_data(data):
   datetime_fields = []
   for fields in data['schema']['fields'][0]['fields']:
      if fields.get('name',None)=='io.debezium.time.Timestamp':
         datetime_fields.append(fields['field'])
   if data['payload']['op'] == 'd':
      data_to_load = data['payload']['before']
   else :    
      data_to_load = data['payload']['after']
   print(data_to_load)
   for k,v in data_to_load.items():
      if k in datetime_fields:
         data_to_load[k] = datetime.datetime.utcfromtimestamp(data_to_load[k] / 1000)
   data_to_load['op'] = data['payload']['op']
   data_to_load['table_name'] = data['payload']['source']['table']
   data_to_load['source_ts_ms'] = datetime.datetime.utcfromtimestamp(data['payload']['source']['ts_ms'] / 1000)
   data_to_load['debezium_ts_ms'] = datetime.datetime.utcfromtimestamp(data['payload']['ts_ms'] / 1000)
   return data_to_load

class create_table(beam.DoFn):
   def process(self,data):
      project_id = "climate-delta-dev"
      dataset_id = "speedwell_stage"
      client = bigquery.Client(project=project_id)
      dataset_ref = client.dataset(dataset_id)
      table_ref = dataset_ref.table(data['payload']['source']['table'])
      try : 
         table = client.get_table(table_ref)
      except :    
         print(set_schema(data))
         schema = [bigquery.SchemaField.from_api_repr(api_repr) for api_repr in set_schema(data)]
         table = bigquery.Table(table_ref, schema=schema)
         table.time_partitioning = bigquery.TimePartitioning(type_=bigquery.TimePartitioningType.DAY)
         client.create_table(table)
      data = format_data(data)
      print(data)
      yield data


def run():
      options = PipelineOptions(streaming=True)
      p = beam.Pipeline(options=options)
      pub_sub_data = (p
                     |"Read From PubSub" >> beam.io.ReadFromPubSub(subscription
                                             ='projects/climate-delta-dev/subscriptions/debezium.all-sub')
                     |"Format PubSub records" >> beam.Map(json_data)
                     |"Windowing to Trigger after each element" >> beam.WindowInto(
                                 window.FixedWindows(2),
                                 accumulation_mode=trigger.AccumulationMode.DISCARDING)
                     |"Create log Tables" >> beam.ParDo(create_table())
                     |"Dump Data to log Tables" >> beam.io.WriteToBigQuery(
                                    table=lambda element:'climate-delta-dev:speedwell_stage.{datatable}'.format(datatable=element['table_name']),
                                    create_disposition=beam.io.BigQueryDisposition.CREATE_IF_NEEDED,
                                    write_disposition=beam.io.BigQueryDisposition.WRITE_APPEND,
                                    method="STREAMING_INSERTS")
                     )

      result = p.run()
      result.wait_until_finish()
run()